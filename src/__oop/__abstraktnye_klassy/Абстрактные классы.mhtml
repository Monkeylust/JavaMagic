.ce-conversion-toolbar, .ce-inline-toolbar, .ce-popover { background: var(-=
-background-tertiary); border-color: var(--border-primary); }

.ce-conversion-tool__icon, .ce-popover__item-icon { background: var(--backg=
round-primary); }

.cdx-attaches { background: var(--background-tertiary) !important; border-c=
olor: var(--border-primary) !important; border-radius: 12px !important; }

.cdx-attaches__file-icon-background, .cdx-attaches__file-icon-label { backg=
round: var(--border-accent) !important; }

.cdx-search-field, .cdx-search-field__input { background: var(--background-=
secondary); }

.ce-block code { border-radius: 2px; background: var(--background-inline-co=
de); color: var(--text-inline-code); padding: 2px 4px; }

.ce-inline-tool-targetlink--button { background: var(--text-accent) !import=
ant; }

.ce-block--selected .ce-block__content { background: var(--background-secon=
dary); }

.ce-block__content { max-width: 100%; }

.ce-toolbar__content { max-width: none; }

.ce-popover__item:hover:not(.ce-popover__item--no-visible-hover) { backgrou=
nd: var(--background-secondary); }

.ce-popover__item--active { color: var(--text-accent); }

.MuiTimeClock-root .MuiClockNumber-root { color: var(--text-primary); }

.draggable { will-change: transform; }

@media (max-width: 768px) {
  body { padding: 0px; }
}

